{
  "name": "vancouver-council-scorecard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "pnpm data:build",
    "data:build": "tsx scripts/build-data.ts",
    "data:validate": "tsx scripts/build-data.ts",
    "data:summary": "tsx scripts/summarize-votes.ts",
    "grades:report": "tsx scripts/analyze-grades.ts",
    "agenda:speakers": "tsx scripts/scrape-meeting-speakers.ts",
    "council:metadata": "pnpm council:filter && tsx scripts/extract-council-vote-metadata.ts",
    "council:match": "tsx scripts/match-scorecard-votes.ts",
    "council:reconcile": "tsx scripts/reconcile-votes.ts",
    "prebuild": "pnpm data:build",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test src/scoring/score.test.ts",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
